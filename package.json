{
  "name": "ardublocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Block based game editor for Arduboy and home made Arduboy compatible devices",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen && tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen": "node scripts/gen-core.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@blockly/field-multilineinput": "^13.3.0",
    "blockly": "^13.3.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
