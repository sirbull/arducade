 "template": {
  "id": "endlessrunner",
  "title": {
   "en": "Void Runner",
   "nb": "Void Runner",
   "de": "Void Runner",
   "es": "Void Runner",
   "fr": "Void Runner"
  },
  "description": {
   "en": "A sci-fi endless runner. Jump with Up/A, slide with Down/B, and beat your best survival time.",
   "nb": "En sci-fi-endlessrunner. Hopp med opp/A, skli med ned/B og slå din beste overlevelsestid.",
   "de": "Ein Sci-Fi-Endlosläufer. Mit Oben/A springen, mit Unten/B rutschen und die beste Überlebenszeit schlagen.",
   "es": "Un corredor infinito de ciencia ficción. Salta con Arriba/A, deslízate con Abajo/B y supera tu mejor tiempo.",
   "fr": "Une course sans fin de science-fiction. Saute avec Haut/A, glisse avec Bas/B et bats ton meilleur temps."
  },
  "tips": [
   {
    "en": "Edit Void Drive in Music Studio. Polyphonic effects briefly interrupt the music; the music continues from the same position after each effect.",
    "nb": "Rediger Void Drive i Musikkstudio. Polyfoniske effekter avbryter musikken kort; musikken fortsetter fra samme sted etter hver effekt.",
    "de": "Void Drive im Musikstudio bearbeiten. Polyphone Effekte unterbrechen die Musik kurz; danach läuft die Musik an derselben Stelle weiter.",
    "es": "Edita Void Drive en el estudio de música. Los efectos polifónicos interrumpen brevemente la música; la música continúa desde la misma posición.",
    "fr": "Modifie Void Drive dans le studio musical. Les effets polyphoniques interrompent brièvement la musique ; la musique reprend ensuite au même endroit."
   },
   {
    "en": "Jump over cargo, reactors and plasma spikes. Slide under drones and laser gates with Down/B for up to 1.5 seconds. Release before sliding again.",
    "nb": "Hopp over last, reaktorer og plasmapigger. Skli under droner og laserporter med ned/B i maks 1,5 sekunder. Slipp før du sklir igjen.",
    "de": "Über Fracht, Reaktoren und Plasmaspitzen springen. Mit Unten/B höchstens 1,5 Sekunden unter Drohnen und Lasertoren rutschen. Vor erneutem Rutschen loslassen.",
    "es": "Salta sobre carga, reactores y púas de plasma. Usa Abajo/B para pasar bajo drones y láseres durante un máximo de 1,5 segundos. Suelta antes de deslizarte de nuevo.",
    "fr": "Saute par-dessus la cargaison, les réacteurs et les pointes de plasma. Glisse sous les drones et lasers avec Bas/B pendant 1,5 seconde maximum. Relâche avant de glisser à nouveau."
   },
   {
    "en": "Speed rises from 60 to 108. Keep the cap and the pause between obstacles to preserve fair jumps.",
    "nb": "Farten øker fra 60 til 108. Behold fartstaket og pausen mellom hindrene for å bevare rettferdige hopp.",
    "de": "Das Tempo steigt von 60 auf 108. Obergrenze und Hindernispausen beibehalten, damit Sprünge fair bleiben.",
    "es": "La velocidad sube de 60 a 108. Conserva el límite y la pausa entre obstáculos para mantener saltos justos.",
    "fr": "La vitesse monte de 60 à 108. Garde la limite et la pause entre obstacles pour préserver des sauts équitables."
   },
   {
    "en": "Edit the mountains and skyline in Backgrounds. The two layers scroll at 25% and 50%.",
    "nb": "Rediger fjellene og bysilhuetten i Bakgrunner. De to lagene ruller med 25 % og 50 %.",
    "de": "Berge und Skyline unter Hintergründe bearbeiten. Die zwei Ebenen scrollen mit 25 % und 50 %.",
    "es": "Edita las montañas y la ciudad en Fondos. Las dos capas se desplazan al 25 % y 50 %.",
    "fr": "Modifie les montagnes et la ville dans Fonds. Les deux calques défilent à 25 % et 50 %."
   }
  ],
  "strings": {
   "en": {
    "setup": "Two repeating parallax layers behind a solid deck. The title and record screens are drawn without blocking input.",
    "fair": "Only one obstacle exists at a time. Wait until it leaves the screen, then wait 12 frames. Speed is capped at 108 so every jump remains possible.",
    "loop": "Scroll wraps at 512 pixels. This is a whole number of repeats for both backgrounds, the deck and the static stars. Shift the obstacle too, so nothing jumps.",
    "controls": "Up/A jumps on a fresh press, only on the ground. Down/B slides for at most 1.5 seconds; release to stand and rearm. The countdown also works across minute rollover. Sliding takes priority when both are held.",
    "records": "Store the best three times as minutes plus centiseconds within the minute. This avoids the 16-bit millisecond limit. Slots 21–27 belong to this game.",
    "ready": "A/^ START",
    "retry": "A/^ RETRY",
    "help": "A/^ JUMP  B/v SLIDE",
    "board": "FLIGHT RECORDS",
    "newBest": "NEW BEST TIME",
    "last": "LAST",
    "time": "TIME"
   },
   "nb": {
    "setup": "To gjentatte parallax-lag bak en solid bane. Tittel- og rekordskjermen tegnes uten å blokkere knappene.",
    "fair": "Bare ett hinder finnes om gangen. Vent til det er ute av skjermen, og deretter 12 bilder. Farten stopper på 108 så alle hopp fortsatt er mulige.",
    "loop": "Rullingen går i loop etter 512 piksler. Det er hele gjentakelser av begge bakgrunnene, banen og stjernene. Flytt også hinderet så ingenting hopper.",
    "controls": "Opp/A hopper ved et nytt trykk, bare på bakken. Ned/B sklir i maks 1,5 sekunder; slipp for å stå og kunne skli igjen. Nedtellingen virker også over et minuttskifte. Skli prioriteres hvis begge holdes inne.",
    "records": "Lagre de tre beste tidene som minutter og hundredeler innenfor minuttet. Dette unngår 16-bitsgrensen for millisekunder. Plass 21–27 tilhører dette spillet.",
    "ready": "A/^ START",
    "retry": "A/^ IGJEN",
    "help": "A/^ HOPP  B/v SKLI",
    "board": "BESTE TIDER",
    "newBest": "NY TIDSREKORD",
    "last": "SIST",
    "time": "TID"
   },
   "de": {
    "setup": "Zwei wiederholte Parallaxebenen hinter einem festen Deck. Titel und Rekorde werden ohne blockierende Eingabe gezeichnet.",
